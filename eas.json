{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.11.1",
      "env": {
        "RALLY_APP_NAME": "Rally",
        "RALLY_APP_SLUG": "rally-mobile"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "android": { "gradleCommand": ":app:assembleDebug" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": false },
      "android": { "gradleCommand": ":app:assembleRelease" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "ios": { "simulator": false },
      "android": { "gradleCommand": ":app:assembleRelease" }
    }
  },
  "submit": {
    "production": {},
    "preview": {}
  }
}
