# Rally Mobile - Environment Variables (template)

# Copy to .env for local dev. NEVER commit .env to source control.

# NEVER put SUPABASE_SERVICE_ROLE_KEY or any server-side secret here.

# The mobile app must only see PUBLIC values.

# --- Public app config (safe for client) ---

RALLY_APP_NAME=Rally
RALLY_APP_SLUG=rally-mobile
RALLY_PUBLIC_BASE_URL=https://rally.app
RALLY_INVITE_URL_PREFIX=https://rally.app/invite/

# --- Supabase public client config (safe for client) ---

# Found in: Supabase Dashboard -> Project Settings -> API

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key-here

# --- Push notifications (Expo) ---

EXPO_PUBLIC_PROJECT_ID=your-expo-project-id

# --- Maps (MVP uses react-native-maps; no key required for default OSM/Apple) ---

# When we move to Mapbox, add:

# EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# --- Feature flags (server-controlled, mirrored to client for UI) ---

EXPO_PUBLIC_FLAG_LIVE_TRACKING=false
EXPO_PUBLIC_FLAG_DIRECT_GARMIN=false
EXPO_PUBLIC_FLAG_DIRECT_FITBIT=false
EXPO_PUBLIC_FLAG_DIRECT_OURA=false
EXPO_PUBLIC_FLAG_DIRECT_WHOOP=false

# ============================================================

# SERVER-ONLY secrets. NEVER prefix with EXPO_PUBLIC_.

#

# These values must NEVER be embedded in the mobile app bundle,

# referenced from client code, or stored in EAS Secrets if EAS

# would expose them to the build target.

#

# The ONLY correct home for SUPABASE_SERVICE_ROLE_KEY and

# provider OAuth client secrets is:

# - Supabase Edge Function Secrets (server-side runtime only)

# - Local admin / migrations environment (server-side tools)

#

# A leaked service-role key bypasses RLS — rotation, not just

# RLS, is the answer if a key is ever exposed.

# ============================================================

# SUPABASE_SERVICE_ROLE_KEY=*** # Edge Function env only, never the mobile app

# SUPABASE_DB_URL=postgres://... # admin / migrations only

# PROVIDER_GARMIN_CLIENT_ID=... # Edge Function env only

# PROVIDER_GARMIN_CLIENT_SECRET=*** # Edge Function env only

# PROVIDER_FITBIT_CLIENT_ID=... # Edge Function env only

# PROVIDER_FITBIT_CLIENT_SECRET=*** # Edge Function env only

# PROVIDER_OURA_CLIENT_ID=... # Edge Function env only

# PROVIDER_OURA_CLIENT_SECRET=*** # Edge Function env only

# PROVIDER_WHOOP_CLIENT_ID=... # Edge Function env only

# PROVIDER_WHOOP_CLIENT_SECRET=*** # Edge Function env only

# ENCRYPTION_KEY_FOR_PROVIDER_TOKENS=... # Edge Function env only

# APNS_KEY_ID=... # EAS submission only

# APNS_TEAM_ID=... # EAS submission only

# FCM_SERVICE_ACCOUNT_JSON=... # EAS submission only
